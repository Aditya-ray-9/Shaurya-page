      background: rgba(0,0,0,0.3);
      backdrop-filter: blur(5px);
      border-radius: 15px;
      padding: 20px;
      box-shadow: var(--card-shadow);
    }

    .quote-container {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin: 30px 0;
      width: 100%;
      max-width: 1100px;
    }

    blockquote {
      font-size: clamp(1rem, 3vw, 1.5rem);
      color: var(--accent-color);
      font-family: 'Great Vibes', cursive;
      padding: 20px;
      text-align: center;
      background: rgba(255,255,255,0.1);
      border-radius: 15px;
      backdrop-filter: blur(5px);
      flex: 1 1 300px;
      max-width: 500px;
      box-shadow: var(--card-shadow);
      transition: var(--transition);
      border-left: 4px solid var(--primary-color);
    }

    blockquote:hover {
      transform: translateY(-5px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    blockquote::before {
      content: '"';
      font-size: 3rem;
      color: var(--primary-color);
      opacity: 0.3;
      position: absolute;
      top: -10px;
      left: 10px;
    }

    blockquote::after {
      content: '"';
      font-size: 3rem;
      color: var(--primary-color);
      opacity: 0.3;
      position: absolute;
      bottom: -30px;
      right: 10px;
    }

    cite {
      display: block;
      margin-top: 10px;
      font-style: normal;
      font-family: 'Poppins', sans-serif;
      font-size: 0.8em;
      color: var(--light-text);
    }

    #album-buttons {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 25px;
      width: 100%;
      max-width: 1200px;
      margin-bottom: 40px;
    }

    .album-button {
      background: rgba(255,255,255,0.9);
      border: none;
      border-radius: 20px;
      padding: 15px;
      font-size: 1.1rem;
      color: var(--primary-color);
      cursor: pointer;
      box-shadow: var(--card-shadow);
      transition: var(--transition);
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow: hidden;
      position: relative;
    }

    .dark-mode .album-button {
      background: var(--dark-secondary);
      color: var(--dark-text);
    }

    .album-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 5px;
      background: linear-gradient(to right, var(--primary-color), var(--secondary-color));
    }

    .album-button img {
      width: 100%;
      height: 180px;
      object-fit: cover;
      border-radius: 15px;
      margin-bottom: 15px;
      transition: var(--transition);
    }

    .album-button:hover {
      transform: translateY(-10px);
      box-shadow: 0 15px 35px rgba(0,0,0,0.2);
    }

    .album-button:hover img {
      transform: scale(1.05);
    }

    .album-year {
      font-size: 0.9rem;
      color: #666;
      margin-top: 5px;
    }

    .dark-mode .album-year {
      color: #aaa;
    }

    /* Modal styles */
    .modal {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: rgba(0,0,0,0.7);
      display: none;
      justify-content: center;
      align-items: center;
      animation: fadeIn 0.3s ease;
      z-index: 100;
      backdrop-filter: blur(5px);
    }

    .modal-content {
      background: #fff;
      border-radius: 20px;
      padding: 30px;
      width: 90%;
      max-width: 700px;
      text-align: center;
      position: relative;
      max-height: 80vh;
      overflow-y: auto;
      box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    }

    .dark-mode .modal-content {
      background: var(--dark-secondary);
      color: var(--dark-text);
    }

    .close {
      position: absolute;
      top: 15px;
      right: 20px;
      font-size: 1.8rem;
      cursor: pointer;
      color: var(--primary-color);
      font-weight: bold;
      transition: var(--transition);
    }

    .close:hover {
      transform: rotate(90deg);
    }

    #album-title {
      font-size: 2rem;
      color: var(--primary-color);
      margin-bottom: 20px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
    }

    #album-info {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-bottom: 30px;
    }

    .album-cover {
      width: 200px;
      height: 200px;
      border-radius: 15px;
      object-fit: cover;
      box-shadow: 0 10px 20px rgba(0,0,0,0.2);
    }

    .album-details {
      text-align: left;
      max-width: 400px;
    }

    .album-details p {
      margin-bottom: 10px;
    }

    .detail-label {
      font-weight: 600;
      color: var(--primary-color);
    }

    .dark-mode .detail-label {
      color: var(--accent-color);
    }

    #songs {
      list-style: none;
      padding: 0;
      color: #555;
      font-size: 1.1rem;
      text-align: left;
      columns: 2;
      column-gap: 30px;
    }

    .dark-mode #songs {
      color: var(--dark-text);
    }

    #songs li {
      margin-bottom: 12px;
      padding-left: 20px;
      position: relative;
      break-inside: avoid;
    }

    #songs li::before {
      content: '\f001';
      font-family: 'Font Awesome 6 Free';
      font-weight: 900;
      position: absolute;
      left: 0;
      color: var(--primary-color);
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      gap: 15px;
      margin: 20px 0 40px;
      justify-content: center;
    }

    .controls button {
      padding: 12px 25px;
      font-size: 1rem;
      border: none;
      border-radius: 50px;
      cursor: pointer;
      background: rgba(255,255,255,0.9);
      color: var(--primary-color);
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
    }

    .dark-mode .controls button {
      background: rgba(30,30,30,0.9);
      color: var(--dark-text);
    }

    .controls button:hover {
      background: var(--primary-color);
      color: white;
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(214, 51, 132, 0.3);
    }

    .player-controls {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 15px;
      margin-top: 30px;
      background: rgba(255,255,255,0.2);
      padding: 15px;
      border-radius: 50px;
      backdrop-filter: blur(5px);
    }

    .player-btn {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: var(--primary-color);
      color: white;
      border: none;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: var(--transition);
      box-shadow: 0 5px 15px rgba(214, 51, 132, 0.4);
    }

    .player-btn:hover {
      transform: scale(1.1);
      background: var(--accent-color);
    }

    .player-btn i {
      font-size: 1.2rem;
    }

    .progress-container {
      flex-grow: 1;
      max-width: 300px;
      height: 6px;
      background: rgba(255,255,255,0.3);
      border-radius: 3px;
      cursor: pointer;
      margin: 0 10px;
    }

    .progress {
      height: 100%;
      background: var(--primary-color);
      border-radius: 3px;
      width: 0%;
      transition: width 0.1s linear;
    }

    .time-display {
      font-size: 0.9rem;
      color: white;
      min-width: 80px;
      text-align: center;
    }

    .volume-control {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .volume-slider {
      width: 80px;
      cursor: pointer;
    }

    footer {
      margin-top: 40px;
      text-align: center;
      color: var(--light-text);
      font-size: 0.9rem;
      padding: 20px;
      width: 100%;
    }

    .social-links {
      display: flex;
      justify-content: center;
      gap: 20px;
      margin-top: 15px;
    }

    .social-links a {
      color: var(--light-text);
      font-size: 1.5rem;
      transition: var(--transition);
    }

    .social-links a:hover {
      color: var(--primary-color);
      transform: translateY(-3px);
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }

    @keyframes pulse {
      0% { transform: scale(1); }
      50% { transform: scale(1.05); }
      100% { transform: scale(1); }
    }

    .pulse {
      animation: pulse 2s infinite;
    }

    /* Responsive adjustments */
    @media (max-width: 768px) {
      #songs {
        columns: 1;
      }
      
      .album-details {
        text-align: center;
      }
      
      .player-controls {
        flex-wrap: wrap;
      }
    }

    @media (max-width: 480px) {
      .controls button {
        padding: 10px 15px;
        font-size: 0.9rem;
      }
      
      .modal-content {
        padding: 20px 15px;
      }
      
      #album-title {
        font-size: 1.5rem;
      }
    }
  </style>
</head>
